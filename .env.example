# ============================================================
#  FB Lead Hunter – konfigurace (zkopíruj na .env a uprav)
# ============================================================

# ---------- Cílový trh ----------
# international = anglicky psané poptávky ze zahraničí, cz = české poptávky
# (určuje výchozí FB Search dotazy; klíčová slova pokrývají obojí)
TARGET_MARKET=international

# ---------- Další zdroje (mimo Facebook, bez přihlášení) ----------
# Reddit: subreddity a dotazy nastavíš v dashboardu (Skupiny & hledání)
REDDIT_ENABLED=true
# Freelancer.com: nové zakázky z webových kategorií
FREELANCER_ENABLED=true
# Zakázky s nižším maximálním rozpočtem / hodinovou sazbou se přeskočí (přepočteno na USD)
FREELANCER_MIN_BUDGET_USD=150
FREELANCER_MIN_HOURLY_USD=15

# ---------- LLM klasifikátor ----------
# groq (doporučeno: zdarma, rychlé, 70B model) | ollama (lokálně, offline)
# | gemini | openai | openrouter  (všechny kromě ollama = OpenAI-kompatibilní API)
LLM_PROVIDER=groq
LLM_API_KEY=
# Prázdné = výchozí model poskytovatele (groq: llama-3.3-70b-versatile, ollama: llama3.1:8b)
LLM_MODEL=
# LLM_BASE_URL=http://localhost:11434
LLM_MAX_REQUESTS_PER_MINUTE=20
# Limit délky odpovědi (novější modely část spotřebují na "přemýšlení")
LLM_MAX_TOKENS=2048

# ---------- Notifikace (stačí jedna) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---------- Filtrace ----------
# Lead = poptávka + aktivní + skóre STRIKTNĚ větší než tato hodnota (8 → jen 9 a 10)
MIN_RELEVANCE_SCORE=8
# Které typy zakázek hlásit jako lead (prázdné = všechny).
# Možnosti: novy_web, eshop, landing_page, redesign, uprava, sprava, seo_rychlost, jine
LEAD_PROJECT_TYPES=novy_web,eshop,landing_page,redesign,uprava,sprava,seo_rychlost
# Starší příspěvky se zahodí ještě před LLM
MAX_POST_AGE_HOURS=72
# Příspěvky, u kterých se nepodaří zjistit čas (vzácné), pustit dál? (v notifikaci budou označené)
ALLOW_UNKNOWN_AGE=true

# ---------- Prohlížeč ----------
HEADLESS=true
# "" = Chromium z Playwrightu, "chrome" = nainstalovaný Google Chrome (méně detekovatelný)
BROWSER_CHANNEL=
# Volitelně přesná cesta k prohlížeči (přebije BROWSER_CHANNEL)
BROWSER_EXECUTABLE_PATH=
# Prázdné = odvodí se automaticky ze skutečné verze prohlížeče (doporučeno, konzistentní otisk)
USER_AGENT=
BROWSER_LOCALE=cs-CZ
BROWSER_TIMEZONE=Europe/Prague
VIEWPORT_WIDTH=1366
VIEWPORT_HEIGHT=768
# Volitelně rezidenční proxy ze stejné země jako obvykle: http://user:pass@host:port
PROXY=
BLOCK_MEDIA=true

# ---------- Ochrana účtu / rate limiting ----------
# Náš čas. 9–1 (přes půlnoc) pokrývá pracovní den v USA; pro české klienty dej 7–23.
ACTIVE_HOURS_START=9
ACTIVE_HOURS_END=1
CYCLE_INTERVAL_MIN_MINUTES=20
CYCLE_INTERVAL_MAX_MINUTES=40
PAUSE_BETWEEN_SOURCES_MIN_S=40
PAUSE_BETWEEN_SOURCES_MAX_S=120
MAX_PAGE_LOADS_PER_HOUR=25
MAX_PAGE_LOADS_PER_DAY=250
MAX_SOURCES_PER_CYCLE=8
MAX_SEARCH_QUERIES_PER_CYCLE=2
SCROLLS_PER_SOURCE_MIN=4
SCROLLS_PER_SOURCE_MAX=9
STOP_AFTER_KNOWN_POSTS=6
STOP_AFTER_OLD_POSTS=5
BLOCKED_COOLDOWN_HOURS=24
